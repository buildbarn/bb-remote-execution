load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "bazelworker_proto",
    srcs = ["worker_protocol.proto"],
    import_prefix = "github.com/buildbarn/bb-remote-execution",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "bazelworker_go_proto",
    importpath = "github.com/buildbarn/bb-remote-execution/pkg/proto/bazelworker",
    proto = ":bazelworker_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "bazelworker",
    embed = [":bazelworker_go_proto"],
    importpath = "github.com/buildbarn/bb-remote-execution/pkg/proto/bazelworker",
    visibility = ["//visibility:public"],
)
